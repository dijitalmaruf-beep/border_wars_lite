rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{gameId} {
      function signedIn() {
        return request.auth != null;
      }

      function isParticipant() {
        return signedIn()
          && resource.data.participantUids is list
          && request.auth.uid in resource.data.participantUids;
      }

      function isCreateRoom() {
        return signedIn()
          && request.resource.data.keys().hasOnly([
            'gameId',
            'status',
            'hostPlayerId',
            'hostUid',
            'participantUids',
            'participants',
            'maxHumanPlayers',
            'hostName',
            'hostColorValue',
            'botCount',
            'difficulty',
            'state',
            'updatedByUid',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.gameId == gameId
          && request.resource.data.status == 'waiting'
          && request.resource.data.hostUid == request.auth.uid
          && request.resource.data.hostPlayerId is string
          && request.resource.data.participantUids is list
          && request.resource.data.participantUids.size() == 1
          && request.resource.data.participantUids[0] == request.auth.uid
          && request.resource.data.participants is list
          && request.resource.data.participants.size() == 1
          && request.resource.data.maxHumanPlayers is int
          && request.resource.data.maxHumanPlayers >= 2
          && request.resource.data.maxHumanPlayers <= 5
          && request.resource.data.botCount is int
          && request.resource.data.botCount >= 0
          && request.resource.data.botCount <= 9
          && request.resource.data.difficulty in ['easy', 'normal', 'hard']
          && request.resource.data.hostName is string
          && request.resource.data.hostName.size() > 0
          && request.resource.data.hostName.size() <= 18
          && request.resource.data.hostColorValue is int
          && request.resource.data.state is map
          && request.resource.data.updatedByUid == request.auth.uid;
      }

      function isJoinRoom() {
        return signedIn()
          && resource.data.status == 'waiting'
          && resource.data.hostUid != request.auth.uid
          && !(request.auth.uid in resource.data.participantUids)
          && request.resource.data.gameId == resource.data.gameId
          && request.resource.data.hostUid == resource.data.hostUid
          && request.resource.data.hostPlayerId == resource.data.hostPlayerId
          && request.resource.data.participantUids is list
          && request.resource.data.participantUids.size() == resource.data.participantUids.size() + 1
          && request.resource.data.participantUids.hasAll(resource.data.participantUids)
          && request.auth.uid in request.resource.data.participantUids
          && request.resource.data.participants is list
          && request.resource.data.participants.size() == request.resource.data.participantUids.size()
          && request.resource.data.botCount is int
          && request.resource.data.botCount >= 0
          && request.resource.data.botCount <= 9
          && request.resource.data.status == 'waiting'
          && request.resource.data.updatedByUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'participantUids',
            'participants',
            'botCount',
            'state',
            'updatedByUid',
            'updatedAt'
          ]);
      }

      function isHostStartGame() {
        return signedIn()
          && resource.data.status == 'waiting'
          && resource.data.hostUid == request.auth.uid
          && resource.data.participantUids is list
          && resource.data.participantUids.size() >= 2
          && request.resource.data.status == 'active'
          && keepsRoomOwnership()
          && request.resource.data.updatedByUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'state',
            'updatedByUid',
            'updatedAt'
          ]);
      }

      function keepsRoomOwnership() {
        return request.resource.data.gameId == resource.data.gameId
          && request.resource.data.hostUid == resource.data.hostUid
          && request.resource.data.participantUids == resource.data.participantUids
          && request.resource.data.hostPlayerId == resource.data.hostPlayerId
          && request.resource.data.participants == resource.data.participants;
      }

      function isParticipantGameUpdate() {
        return isParticipant()
          && resource.data.status in ['active', 'finished']
          && request.resource.data.status in ['active', 'finished']
          && keepsRoomOwnership()
          && request.resource.data.updatedByUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'state',
            'updatedByUid',
            'updatedAt'
          ]);
      }

      allow get: if signedIn()
        && (resource.data.status == 'waiting' || isParticipant());
      allow list: if false;
      allow create: if isCreateRoom();
      allow update: if isJoinRoom() || isHostStartGame() || isParticipantGameUpdate();
      allow delete: if false;

      match /presence/{playerId} {
        function gamePath() {
          return /databases/$(database)/documents/games/$(gameId);
        }

        function isPresenceParticipant() {
          return signedIn()
            && exists(gamePath())
            && get(gamePath()).data.participantUids is list
            && request.auth.uid in get(gamePath()).data.participantUids;
        }

        function isValidPresence() {
          return request.resource.data.keys().hasOnly([
            'playerId',
            'uid',
            'isOnline',
            'lastSeenAt'
          ])
          && request.resource.data.playerId == playerId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.isOnline is bool
          && request.resource.data.lastSeenAt is timestamp
          && request.resource.data.lastSeenAt >= request.time - duration.value(10, 'm')
          && request.resource.data.lastSeenAt <= request.time + duration.value(1, 'm');
        }

        allow read: if isPresenceParticipant();
        allow create, update: if isPresenceParticipant() && isValidPresence();
        allow delete: if false;
      }

      match /chatMessages/{messageId} {
        // TODO: Before production, also verify senderPlayerId against the
        // participant record for request.auth.uid. This development rule keeps
        // chat scoped to room participants and limits text size.
        function gamePath() {
          return /databases/$(database)/documents/games/$(gameId);
        }

        function isChatParticipant() {
          return signedIn()
            && exists(gamePath())
            && get(gamePath()).data.participantUids is list
            && request.auth.uid in get(gamePath()).data.participantUids;
        }

        function isValidChatMessage() {
          return request.resource.data.keys().hasOnly([
            'gameId',
            'senderPlayerId',
            'senderName',
            'senderColor',
            'text',
            'createdAt',
            'type'
          ])
          && request.resource.data.gameId == gameId
          && request.resource.data.senderPlayerId is string
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() > 0
          && request.resource.data.senderName.size() <= 18
          && request.resource.data.senderColor is int
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 120
          && isValidChatTimestamp()
          && request.resource.data.type in ['user', 'system'];
        }

        function isValidChatTimestamp() {
          return request.resource.data.createdAt is timestamp
            && request.resource.data.createdAt >= request.time - duration.value(10, 'm')
            && request.resource.data.createdAt <= request.time + duration.value(1, 'm');
        }

        allow read: if isChatParticipant();
        allow create: if isChatParticipant() && isValidChatMessage();
        allow update, delete: if false;
      }
    }
  }
}
